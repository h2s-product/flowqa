# Port server backend (API + UI hasil build)
PORT=4000
# Lokasi file database SQLite
FLOWQA_DB=./data/flowqa.db
# Isi data demo saat database masih kosong (true/false)
FLOWQA_SEED=true
# Interval pengecekan jadwal (ms)
FLOWQA_SCHEDULER_INTERVAL_MS=20000
# Lama sesi login (hari)
FLOWQA_SESSION_DAYS=7
# Opsional: buat akun admin otomatis saat belum ada akun sama sekali.
# Kosongkan untuk membuat akun pertama lewat UI.
FLOWQA_ADMIN_EMAIL=
FLOWQA_ADMIN_PASSWORD=
FLOWQA_ADMIN_NAME=Admin
# UI Tester: browser yang dipakai (default Google Chrome yang terpasang)
FLOWQA_BROWSER_CHANNEL=chrome
# FLOWQA_BROWSER_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
# Folder screenshot hasil UI test
FLOWQA_UI_ARTIFACTS=./data/ui-artifacts

# Email hasil test (SMTP). Kosongkan FLOWQA_SMTP_HOST untuk mematikan email.
# Contoh Gmail: host smtp.gmail.com, port 587, user = alamat Gmail, password = App Password.
FLOWQA_SMTP_HOST=
FLOWQA_SMTP_PORT=587
# true untuk TLS langsung (port 465), false untuk STARTTLS (port 587)
FLOWQA_SMTP_SECURE=false
FLOWQA_SMTP_USER=
FLOWQA_SMTP_PASSWORD=
# Pengirim email, mis. "Testora <qa@perusahaan.com>" (default: FLOWQA_SMTP_USER)
FLOWQA_MAIL_FROM=
# Alamat web Testora untuk tautan di email (development: http://localhost:5173)
FLOWQA_APP_URL=

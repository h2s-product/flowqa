{
  "name": "@flowqa/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:express --external:js-yaml --external:undici --external:playwright-core --external:nodemailer",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowqa/shared": "*",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "nodemailer": "^10.0.10",
    "playwright-core": "^1.63.0",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
